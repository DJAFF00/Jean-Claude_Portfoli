# Neon : Dashboard > Connection details
# DATABASE_URL = chaîne "pooled" (avec -pooler dans l'hôte)
# DIRECT_URL   = chaîne directe (sans -pooler)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# Admin (en local, échappe chaque $ du hash avec \$ ; sur Vercel, colle le hash tel quel)
ADMIN_EMAIL="ton@email.com"
ADMIN_PASSWORD_HASH=""
# openssl rand -base64 32
AUTH_SECRET=""

# Vercel Storage > Blob (créé automatiquement quand tu connectes le store au projet)
BLOB_READ_WRITE_TOKEN=""
