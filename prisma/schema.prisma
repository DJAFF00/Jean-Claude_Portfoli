generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id        Int     @id @default(1)
  fullName  String
  headline  String
  bio       String
  email     String
  phone     String?
  location  String?
  github    String?
  linkedin  String?
  cvUrl     String?
  photoUrl  String?
  available Boolean @default(true)
}

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String
  description String   @default("")
  imageUrl    String?
  stack       String[]
  liveUrl     String?
  repoUrl     String?
  published   Boolean  @default(false)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Experience {
  id          String  @id @default(cuid())
  place       String
  role        String
  period      String?
  description String?
  position    Int     @default(0)
}

model Education {
  id       String  @id @default(cuid())
  school   String
  degree   String
  years    String?
  details  String?
  position Int     @default(0)
}

model Skill {
  id       String @id @default(cuid())
  category String
  items    String
  position Int    @default(0)
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
